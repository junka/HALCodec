NVEnc/Video_Codec_SDK_13.0.19/Samples

# AMF SDK: track the headers/docs (needed at build time), skip the 1.2G
# third-party binaries and CI metadata (akin to .git).
AMF/AMF-*/.github/
AMF/AMF-*/Thirdparty/

# libvpl SDK (QSV): track the full source (needed at build time), skip CI
# metadata (akin to .git).
QSV/libvpl-*/.github/

# vpl-gpu-rt (libmfx-gen implementation) is built from source into a ~1G tree
# with a full build/ dir; not tracked. Fetch via tools/update_sdks.sh vplgpu.
QSV/vpl-gpu-rt-*/

# Decode test output (raw NV12 produced by hal_dec -f yuv).
QSV/libvpl-*/examples/content/*.yuv

# Test assets regenerated from cars_320x240.nv12 by scripts/regression_nvenc.sh
# (JPEG/BMP single-frame, MJPEG AVI + raw concatenated streams).
test_cars_320x240.jpg
test_cars_320x240.bmp
test_cars_mjpeg.avi
test_cars_mjpeg.mjpeg
